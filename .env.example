# Copy to .env and fill in. .env is ignored by git.

# Optional: store stages in MongoDB instead of a file. The full connection string, password included.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=celebrations

# Optional: Gemini key for AI-drawn looks, and which model draws them (default gemini-3.8-flash)
GEMINI_API_KEY=
# GEMINI_MODEL=
